<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<variable name="layout"
			  value="${longdate} ${uppercase:${level}} [${scopeproperty:CorrelationId}] ${logger:shortName=true} ${message} ${exception:format=tostring}" />

	<targets>
		<target xsi:type="File"
				name="file"
				fileName="${basedir}/logs/gamehub-${shortdate}.log"
				layout="${layout}"
				archiveEvery="Day"
				maxArchiveFiles="14"
				keepFileOpen="false"
				encoding="utf-8" />
		<target xsi:type="Console"
				name="console"
				layout="${layout}" />
	</targets>

	<rules>
		<logger name="Microsoft.*" maxlevel="Info" final="true" />
		<logger name="System.*" maxlevel="Info" final="true" />
		<logger name="*" minlevel="Debug" writeTo="file" />
		<logger name="*" minlevel="Info" writeTo="console" />
	</rules>
</nlog>